<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PKHeX.Mobile.Pages.MysteryGiftDBPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThPageBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" BackgroundColor="{DynamicResource ThPageBg}">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
              BackgroundColor="{DynamicResource ThCardBg}"
              Padding="18,14,18,12">
            <Label Text="神秘礼物"
                   FontFamily="NunitoBold" FontSize="11"
                   TextColor="{DynamicResource ThTextDim}" CharacterSpacing="1.5"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="↕ 上下  A 接收  B 返回"
                   FontFamily="Nunito" FontSize="9"
                   TextColor="{DynamicResource ThTextHint}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- 礼物库（自备卡） -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"
              Padding="16,10,16,2" BackgroundColor="{DynamicResource ThCardBg}">
            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                <Label x:Name="LibraryCountLabel" FontFamily="Nunito" FontSize="11"
                       TextColor="{DynamicResource ThTextSecondary}" MaxLines="1"
                       LineBreakMode="TailTruncation" Text="自备礼物卡：0 张" />
                <Label x:Name="LibraryPathLabel" FontFamily="Nunito" FontSize="9"
                       TextColor="{DynamicResource ThTextDim}" MaxLines="1"
                       LineBreakMode="HeadTruncation" />
            </VerticalStackLayout>

            <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Padding="12,6"
                    BackgroundColor="{DynamicResource ThHintBg}"
                    Stroke="{DynamicResource ThHintStroke}" StrokeThickness="1"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnImportTapped" />
                </Border.GestureRecognizers>
                <Label Text="导入礼物卡" FontFamily="NunitoBold" FontSize="11"
                       TextColor="{DynamicResource ThTextPrimary}" />
            </Border>
        </Grid>

        <!-- Filter bar -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource ThCardBg}"
                Stroke="{DynamicResource ThDivider}" StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Margin="14,8,14,4" Padding="12,2">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry x:Name="SearchEntry"
                       Placeholder="搜索卡片标题或宝可梦"
                       PlaceholderColor="{DynamicResource ThTextHint}"
                       BackgroundColor="Transparent"
                       TextColor="{DynamicResource ThTextPrimary}"
                       TextChanged="OnFilterChanged" />
                <Label Grid.Column="1"
                       Text="可兼容" FontFamily="Nunito" FontSize="12"
                       TextColor="{DynamicResource ThTextSecondary}"
                       VerticalOptions="Center" />
                <Switch Grid.Column="2" x:Name="CompatibleOnly"
                        IsToggled="True" Toggled="OnFilterChanged"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Gift list -->
        <CollectionView Grid.Row="3" x:Name="GiftList"
                        SelectionMode="Single"
                        SelectionChanged="OnGiftSelected"
                        BackgroundColor="Transparent"
                        Margin="14,6,14,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                                BackgroundColor="{DynamicResource ThCardBg}"
                                Stroke="{DynamicResource ThDivider}"
                                Padding="0">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Stroke" Value="#4A90D9" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                        <Grid ColumnDefinitions="56,*,Auto" Padding="10,8" ColumnSpacing="10">
                            <Image Grid.Column="0"
                                   Source="{Binding SpriteSource}"
                                   WidthRequest="56" HeightRequest="46"
                                   Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontFamily="NunitoExtraBold" FontSize="13"
                                       TextColor="{DynamicResource ThTextPrimary}" />
                                <Label Text="{Binding SubInfo}"
                                       FontFamily="Nunito" FontSize="11"
                                       TextColor="{DynamicResource ThTextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding GenLabel}"
                                   FontFamily="Nunito" FontSize="11"
                                   TextColor="{DynamicResource ThTextDim}"
                                   VerticalOptions="Center" />
                        </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="没有找到神秘礼物。"
                       HorizontalOptions="Center"
                       FontFamily="Nunito" FontSize="14"
                       TextColor="{DynamicResource ThTextSecondary}"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- 底部：我接收的礼物 -->
        <Border Grid.Row="4" Margin="14,6,14,10" Padding="14,10"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{DynamicResource ThHintBg}"
                Stroke="{DynamicResource ThHintStroke}" StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnReceivedTapped" />
            </Border.GestureRecognizers>
            <Label Text="我接收的礼物" FontFamily="NunitoBold" FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="{DynamicResource ThTextPrimary}" />
        </Border>

        <!-- 礼物槽列表浮层 -->
        <Grid x:Name="ReceivedOverlay" Grid.RowSpan="5" IsVisible="False"
              BackgroundColor="#B3000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnReceivedBackdropTapped" />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="End" StrokeShape="RoundRectangle 16,16,0,0"
                    BackgroundColor="{DynamicResource ThCardBg}"
                    Stroke="{DynamicResource ThDivider}" StrokeThickness="1"
                    Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReceivedPanelTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="ReceivedTitle" FontFamily="NunitoExtraBold" FontSize="14"
                               TextColor="{DynamicResource ThTextPrimary}" VerticalOptions="Center" />
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Padding="8,2"
                                BackgroundColor="{DynamicResource ThHintBg}"
                                Stroke="{DynamicResource ThHintStroke}" StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnReceivedCloseTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="✕" FontFamily="NunitoBold" FontSize="12"
                                   TextColor="{DynamicResource ThTextSecondary}" />
                        </Border>
                    </Grid>

                    <ScrollView MaximumHeightRequest="420">
                        <VerticalStackLayout x:Name="ReceivedList" Spacing="6" />
                    </ScrollView>

                    <Label x:Name="ReceivedHint" FontFamily="Nunito" FontSize="10"
                           TextColor="{DynamicResource ThTextDim}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
