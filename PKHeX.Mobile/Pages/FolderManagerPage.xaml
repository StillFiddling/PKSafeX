<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:PKHeX.Mobile.Theme"
             x:Class="PKHeX.Mobile.Pages.FolderManagerPage"
             Title="Manage Save Folders/Files"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThSettingsBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16"
          BackgroundColor="{DynamicResource ThSettingsBg}">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,12,0,8">
            <Border Grid.Column="0" BackgroundColor="Transparent" Stroke="Transparent" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center" Padding="0,6">
                    <Label Text="{x:Static theme:Ph.ArrowLeft}"
                           FontFamily="Phosphor" FontSize="18"
                           TextColor="{DynamicResource ThAccent}"
                           VerticalOptions="Center" />
                    <Label Text="返回"
                           FontFamily="NunitoBold" FontSize="14"
                           TextColor="{DynamicResource ThAccent}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Label Grid.Column="1" Text="存档文件夹"
                   FontFamily="NunitoBold" FontSize="20"
                   TextColor="{DynamicResource ThTextPrimary}"
                   VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>

        <!-- Gamepad hint -->
        <Label Grid.Row="1"
               Text="↕ scroll  X remove  L add folder  R add file  B back"
               FontSize="10" TextColor="{DynamicResource ThTextDim}"
               HorizontalOptions="End" Margin="0,0,0,8" />

        <!-- 权限提示条：没授权时一直显示，点了直接跳系统设置 -->
        <Border x:Name="PermissionBanner" Grid.Row="2" IsVisible="False"
                Margin="0,0,0,8" Padding="12,10"
                StrokeShape="RoundRectangle 6" Stroke="#FFB020" StrokeThickness="1"
                BackgroundColor="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGrantClicked" />
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="4">
                <Label Text="⚠ 还没开「所有文件访问」权限"
                       FontFamily="NunitoBold" FontSize="14"
                       TextColor="#FFB020" />
                <Label Text="Android/data 里的存档（AzaharPlus / Citra 等）读不到。点这里去授权 →"
                       FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
            </VerticalStackLayout>
        </Border>

        <!-- Directory/file list -->
        <CollectionView x:Name="DirList" Grid.Row="3"
                        SelectionMode="Single"
                        BackgroundColor="Transparent">
            <CollectionView.EmptyView>
                <Label Text="还没有添加文件夹或文件。"
                       TextColor="{DynamicResource ThTextSecondary}" FontSize="14"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Margin="24,40" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,4" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{DynamicResource ThSettingsRow}"
                            Stroke="Transparent" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontFamily="Phosphor" FontSize="18"
                                   TextColor="{DynamicResource ThAccentLight}"
                                   VerticalOptions="Center" Margin="0,0,10,0" />
                            <Label Grid.Column="1"
                                   Text="{Binding Label}"
                                   TextColor="{DynamicResource ThTextPrimary}"
                                   FontSize="13"
                                   LineBreakMode="MiddleTruncation"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="🗑 移出"
                                    Clicked="OnRemoveClicked"
                                    CommandParameter="{Binding .}"
                                    FontFamily="NunitoBold" FontSize="12"
                                    TextColor="#FF6060"
                                    BackgroundColor="{DynamicResource ThNavBtnBg}"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    HeightRequest="34"
                                    MinimumWidthRequest="78"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,12,0,12">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource ThNavBtnBg}"
                    Stroke="{DynamicResource ThAccent}" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddFolderClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                       Spacing="8" Padding="0,14">
                    <Label Text="{x:Static theme:Ph.Folder}"
                           FontFamily="Phosphor" FontSize="20"
                           TextColor="{DynamicResource ThAccentLight}"
                           VerticalOptions="Center" />
                    <Label Text="添加文件夹"
                           FontFamily="NunitoBold" FontSize="15"
                           TextColor="{DynamicResource ThAccentLight}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="1" StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource ThNavBtnBg}"
                    Stroke="{DynamicResource ThAccent}" Padding="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddFileClicked" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                       Spacing="8" Padding="0,14">
                    <Label Text="{x:Static theme:Ph.FloppyDisk}"
                           FontFamily="Phosphor" FontSize="20"
                           TextColor="{DynamicResource ThAccentLight}"
                           VerticalOptions="Center" />
                    <Label Text="新增存档"
                           FontFamily="NunitoBold" FontSize="15"
                           TextColor="{DynamicResource ThAccentLight}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
