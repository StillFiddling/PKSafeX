<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="PKHeX.Mobile.Pages.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThSettingsBg}">

    <ScrollView x:Name="RootScroll" Padding="16" BackgroundColor="{DynamicResource ThSettingsBg}">
        <VerticalStackLayout Spacing="12">

            <!-- Gamepad hint -->
            <Label Text="↕ 上下移动   ◀▶ 切换   A 开关   B 返回"
                   FontSize="10" TextColor="{DynamicResource ThTextDim}"
                   HorizontalOptions="End" />

            <!-- Language -->
            <Border x:Name="Row_Language" StyleId="Pick:Language"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="显示语言"
                           FontAttributes="Bold" FontSize="15"
                           TextColor="{DynamicResource ThTextPrimary}" />
                    <Label Text="影响宝可梦、招式与特性的名称，重新打开页面后生效。"
                           FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    <Picker x:Name="LanguagePicker"
                            SelectedIndexChanged="OnLanguageChanged"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource ThTextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Shiny sprites -->
            <Border x:Name="Row_Shiny" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="显示闪光立绘"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="闪光宝可梦使用异色立绘。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="ShinySwitch"
                            Toggled="OnShinySwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Radar adaptive scale -->
            <Border x:Name="Row_Radar" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="雷达自适应比例"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="按该宝可梦最高数值缩放图表，弱一些的宝可梦也能充满图像。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="RadarAdaptiveSwitch"
                            Toggled="OnRadarAdaptiveToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Manage Folders -->
            <Border x:Name="Row_Folders" StyleId="Navigate"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="管理存档文件夹"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="添加或移除开机时扫描存档的文件夹。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThAccent}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Legality badges -->
            <Border x:Name="Row_Legality" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="显示合法性标记"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="在箱子中为每只宝可梦显示合法/非法状态点。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="LegalitySwitch"
                            Toggled="OnLegalitySwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Theme -->
            <Border x:Name="Row_Theme" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="浅色主题"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="切换为浅色任天堂风格外观。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="ThemeSwitch"
                            Toggled="OnThemeSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Moiré hero background -->
            <Border x:Name="Row_HeroBg" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="摩尔纹背景"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="存档卡片背后的动态角色图案，关闭后使用经典渐变背景。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="MoireSwitch"
                            Toggled="OnMoireSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Animated 3D sprites -->
            <Border x:Name="Row_Animated3D" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="3D 动态立绘"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="显示宝可梦 Showdown 动态立绘，关闭则改用 HOME 风格立绘。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="Animated3DSwitch"
                            Toggled="OnAnimated3DSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- HOME sprite cache download -->
            <Border x:Name="Row_Sprites"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSpriteDownloadTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="下载 HOME 立绘"
                                   FontAttributes="Bold" FontSize="15"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                            <Label x:Name="SpriteStatusLabel"
                                   Text="~120 MB · caches HOME sprites for all Pokémon"
                                   FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="1" WidthRequest="52" HeightRequest="52"
                              VerticalOptions="Center" HorizontalOptions="End">
                            <skia:SKCanvasView x:Name="SpriteRingCanvas"
                                               PaintSurface="OnSpriteRingPaint"
                                               WidthRequest="52" HeightRequest="52" />
                            <Label x:Name="SpriteRingLabel"
                                   FontFamily="NunitoBold" FontSize="10"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                        </Grid>
                    </Grid>
                    <Border x:Name="SpriteLogPanel" IsVisible="False"
                            BackgroundColor="{DynamicResource ThSettingsBg}"
                            StrokeShape="RoundRectangle 4" Stroke="Transparent" Padding="8,6">
                        <ScrollView x:Name="SpriteLogScroll" HeightRequest="130" Orientation="Vertical">
                            <Label x:Name="SpriteLogLabel" FontSize="10"
                                   TextColor="{DynamicResource ThTextSecondary}"
                                   LineBreakMode="CharacterWrap" />
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Animated sprite cache download -->
            <Border x:Name="Row_AnimSprites"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAnimSpriteDownloadTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="下载动态立绘"
                                   FontAttributes="Bold" FontSize="15"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                            <Label x:Name="AnimSpriteStatusLabel"
                                   Text="~200 MB · caches animated GIFs for all Pokémon"
                                   FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="1" WidthRequest="52" HeightRequest="52"
                              VerticalOptions="Center" HorizontalOptions="End">
                            <skia:SKCanvasView x:Name="AnimRingCanvas"
                                               PaintSurface="OnAnimRingPaint"
                                               WidthRequest="52" HeightRequest="52" />
                            <Label x:Name="AnimRingLabel"
                                   FontFamily="NunitoBold" FontSize="10"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                        </Grid>
                    </Grid>
                    <Border x:Name="AnimLogPanel" IsVisible="False"
                            BackgroundColor="{DynamicResource ThSettingsBg}"
                            StrokeShape="RoundRectangle 4" Stroke="Transparent" Padding="8,6">
                        <ScrollView x:Name="AnimLogScroll" HeightRequest="130" Orientation="Vertical">
                            <Label x:Name="AnimLogLabel" FontSize="10"
                                   TextColor="{DynamicResource ThTextSecondary}"
                                   LineBreakMode="CharacterWrap" />
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Always show welcome wizard -->
            <Border x:Name="Row_Welcome" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="总是显示初始化向导"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="每次启动都显示初始化向导（用于测试）。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="WelcomeSwitch"
                            Toggled="OnWelcomeSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Section header -->
            <Label Text="模拟器存档"
                   FontSize="10" FontAttributes="Bold"
                   TextColor="{DynamicResource ThTextDim}" Margin="4,8,0,2" />

            <!-- Eden (Switch Gen 8/9) -->
            <Border x:Name="Row_EdenScan"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFindEdenTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="查找 Eden 存档（Switch）"
                                   FontAttributes="Bold" FontSize="15"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                            <Label Text="授权访问 eden 文件夹，会自动扫描所有宝可梦存档。"
                                   FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="20"
                               TextColor="{DynamicResource ThAccent}"
                               VerticalOptions="Center" Margin="8,0,0,0" />
                    </Grid>
                    <Label x:Name="EdenStatusLabel" FontSize="11"
                           TextColor="{DynamicResource ThAccent}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- MelonDS (DS Gen 4/5) -->
            <Border x:Name="Row_MelonDSScan"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFindMelonDSTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="添加 MelonDS 存档文件夹（DS）"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="存档是与 ROM 同目录的 .sav 文件，请指向 ROM 或存档文件夹。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThAccent}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Azahar (3DS Gen 6/7) -->
            <Border x:Name="Row_AzaharScan"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFindAzaharTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="查找 Azahar 存档（3DS）"
                                   FontAttributes="Bold" FontSize="15"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                            <Label Text="授权访问 Azahar 文件夹，会自动扫描 sdmc/Nintendo 3DS。"
                                   FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="20"
                               TextColor="{DynamicResource ThAccent}"
                               VerticalOptions="Center" Margin="8,0,0,0" />
                    </Grid>
                    <Label x:Name="AzaharStatusLabel" FontSize="11"
                           TextColor="{DynamicResource ThAccent}" IsVisible="False" />
                </VerticalStackLayout>
            </Border>


            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- RetroArch (GBA/GBC Gen 1–3) -->
            <Border x:Name="Row_RetroArchScan"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFindRetroArchTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="添加 RetroArch 存档文件夹（GBA/GBC）"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="指向 RetroArch 存档文件夹，存档是以 ROM 命名的 .srm 文件。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThAccent}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
