<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="PKHeX.Mobile.Pages.SettingsPage"
             Title="Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThSettingsBg}">

    <ScrollView x:Name="RootScroll" Padding="16" BackgroundColor="{DynamicResource ThSettingsBg}">
        <VerticalStackLayout Spacing="12">

            <!-- Gamepad hint -->
            <Label Text="↕ 上下移动   ◀▶ 切换   A 开关   B 返回"
                   FontSize="10" TextColor="{DynamicResource ThTextDim}"
                   HorizontalOptions="End" />

            <!-- Language -->
            <Border x:Name="Row_Language" StyleId="Pick:Language"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label Text="显示语言"
                           FontAttributes="Bold" FontSize="15"
                           TextColor="{DynamicResource ThTextPrimary}" />
                    <Label Text="影响宝可梦、招式与特性的名称，重新打开页面后生效。"
                           FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    <Picker x:Name="LanguagePicker"
                            SelectedIndexChanged="OnLanguageChanged"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource ThTextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Shiny sprites -->
            <Border x:Name="Row_Shiny" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="显示闪光立绘"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="闪光宝可梦使用异色立绘。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="ShinySwitch"
                            Toggled="OnShinySwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Radar adaptive scale -->
            <Border x:Name="Row_Radar" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="雷达自适应比例"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="按该宝可梦最高数值缩放图表，弱一些的宝可梦也能充满图像。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="RadarAdaptiveSwitch"
                            Toggled="OnRadarAdaptiveToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Manage Folders -->
            <Border x:Name="Row_Folders" StyleId="Navigate"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFoldersTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="管理存档文件夹"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="添加或移除开机时扫描存档的文件夹。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThAccent}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- 自动扫描全部模拟器（默认关闭；开启需「所有文件访问权限」）-->
            <Border x:Name="Row_AutoScan"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="自动扫描全部模拟器"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="开启后自动去 Android/data 里找存档，需要「所有文件访问权限」。不想授权就关着，进「管理存档文件夹」手动添加。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="AutoScanSwitch"
                            Toggled="OnAutoScanSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Legality badges -->
            <Border x:Name="Row_Legality" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="显示合法性标记"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="在箱子中为每只宝可梦显示合法/非法状态点。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="LegalitySwitch"
                            Toggled="OnLegalitySwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Theme -->
            <Border x:Name="Row_Theme" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="浅色主题"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="切换为浅色任天堂风格外观。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="ThemeSwitch"
                            Toggled="OnThemeSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Moiré hero background -->
            <Border x:Name="Row_HeroBg" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="摩尔纹背景"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="存档卡片背后的动态角色图案，关闭后使用经典渐变背景。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="MoireSwitch"
                            Toggled="OnMoireSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- Animated 3D sprites -->
            <Border x:Name="Row_Animated3D" StyleId="Toggle"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="3D 动态立绘"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="显示宝可梦 Showdown 动态立绘，关闭则改用 HOME 风格立绘。"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="Animated3DSwitch"
                            Toggled="OnAnimated3DSwitchToggled" VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- HOME 立绘：点进二级页选择下载或导入 -->
            <Border x:Name="Row_Sprites"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeSpritesTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="HOME 立绘"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label x:Name="HomeSpriteSummaryLabel"
                               Text="下载或导入 HOME 立绘"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThTextDim}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- 动态立绘：点进二级页选择下载或导入 -->
            <Border x:Name="Row_AnimSprites"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAnimSpritesTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="动态立绘"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label x:Name="AnimSpriteSummaryLabel"
                               Text="下载或导入动态立绘"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThTextDim}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- 诊断日志导出（临时排查用，正式版移除） -->
            <Border x:Name="Row_ExportDiag"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExportDiagTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="导出布局日志"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label x:Name="DiagLogSummaryLabel"
                               Text="临时诊断：记录箱子页/银行页各行的实测高度，点一下保存文件并复制到剪贴板，直接粘贴发给作者"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThTextDim}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- 诊断记录开关：默认关闭，反馈问题时再打开 -->
            <Border x:Name="Row_DiagSwitch"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="诊断记录"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label Text="反馈卡顿/异常时打开，之后用上一行的「导出布局日志」发我；平时保持关闭不占性能"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="DiagSwitch"
                            OnColor="{DynamicResource ThAccent}"
                            Toggled="OnDiagSwitchToggled"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- 存档备份概况（每次写回前自动存一份到应用私有目录） -->
            <Border x:Name="Row_SaveBackup"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveBackupTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="存档备份"
                               FontAttributes="Bold" FontSize="15"
                               TextColor="{DynamicResource ThTextPrimary}" />
                        <Label x:Name="SaveBackupSummaryLabel"
                               Text="每次写回存档前都会自动留一份，最多保留 20 份"
                               FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="20"
                           TextColor="{DynamicResource ThTextDim}"
                           VerticalOptions="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>

            </VerticalStackLayout>
    </ScrollView>

</ContentPage>
