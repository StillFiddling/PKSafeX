<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:theme="clr-namespace:PKHeX.Mobile.Theme"
             x:Class="PKHeX.Mobile.Pages.SpriteSourcePage"
             Title="Sprites"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThSettingsBg}">

    <ScrollView x:Name="RootScroll" Padding="16" BackgroundColor="{DynamicResource ThSettingsBg}">
        <VerticalStackLayout Spacing="12">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,4">
                <Border Grid.Column="0" BackgroundColor="Transparent" Stroke="Transparent" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center" Padding="0,6">
                        <Label Text="{x:Static theme:Ph.ArrowLeft}"
                               FontFamily="Phosphor" FontSize="18"
                               TextColor="{DynamicResource ThAccent}"
                               VerticalOptions="Center" />
                        <Label Text="返回"
                               FontFamily="NunitoBold" FontSize="14"
                               TextColor="{DynamicResource ThAccent}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Label Grid.Column="1" x:Name="PageTitleLabel" Text="立绘"
                       FontFamily="NunitoBold" FontSize="20"
                       TextColor="{DynamicResource ThTextPrimary}"
                       VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>

            <Label Text="A 开始 / 停止   B 返回"
                   FontSize="10" TextColor="{DynamicResource ThTextDim}"
                   HorizontalOptions="End" />

            <!-- 下载 -->
            <Border x:Name="Row_Download"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDownloadTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label x:Name="DownloadTitleLabel" Text="下载"
                                   FontAttributes="Bold" FontSize="15"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                            <Label x:Name="StatusLabel" Text=""
                                   FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="1" WidthRequest="52" HeightRequest="52"
                              VerticalOptions="Center" HorizontalOptions="End">
                            <skia:SKCanvasView x:Name="RingCanvas"
                                               PaintSurface="OnRingPaint"
                                               WidthRequest="52" HeightRequest="52" />
                            <Label x:Name="RingLabel"
                                   FontFamily="NunitoBold" FontSize="10"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{DynamicResource ThTextPrimary}" />
                        </Grid>
                    </Grid>
                    <Border x:Name="LogPanel" IsVisible="False"
                            BackgroundColor="{DynamicResource ThSettingsBg}"
                            StrokeShape="RoundRectangle 4" Stroke="Transparent" Padding="8,6">
                        <ScrollView x:Name="LogScroll" HeightRequest="130" Orientation="Vertical">
                            <Label x:Name="LogLabel" FontSize="10"
                                   TextColor="{DynamicResource ThTextSecondary}"
                                   LineBreakMode="CharacterWrap" />
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <!-- 导入 ZIP -->
            <Border x:Name="Row_Import"
                    BackgroundColor="{DynamicResource ThSettingsRow}" Stroke="Transparent"
                    StrokeShape="RoundRectangle 6" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnImportTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ImportTitleLabel" Text="导入精灵包（ZIP）"
                           FontAttributes="Bold" FontSize="15"
                           TextColor="{DynamicResource ThTextPrimary}" />
                    <Label x:Name="ImportStatusLabel" Text=""
                           FontSize="12" TextColor="{DynamicResource ThTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{DynamicResource ThDivider}" />

            <Label x:Name="DetailLabel" Text=""
                   FontSize="12" TextColor="{DynamicResource ThTextDim}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
