<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:theme="clr-namespace:PKHeX.Mobile.Theme"
             xmlns:svc="clr-namespace:PKHeX.Mobile.Services"
             x:Class="PKHeX.Mobile.Pages.BankPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThPageBg}">

    <!-- 外层 Grid：详情浮层是 RootGrid 的兄弟，避免底部被溢出裁掉 -->
    <Grid>
        <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              BackgroundColor="{DynamicResource ThPageBg}">

            <!-- ── Save header（与箱子页顶部完全同款：图标 + 名字 + 游戏名 + 箱子 ▸） ── -->
            <Grid x:Name="HeaderRow" Grid.Row="0" ColumnDefinitions="Auto,12,*,Auto"
                  BackgroundColor="Transparent" Padding="14,10,10,6">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSaveChipTapped" />
                </Grid.GestureRecognizers>
                <Border StrokeShape="RoundRectangle 10"
                        Stroke="#0FFFFFFF" StrokeThickness="1"
                        WidthRequest="58" HeightRequest="58" VerticalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#26394880" Offset="0" />
                            <GradientStop Color="#1AA78BFA" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image x:Name="BankGameIcon" Aspect="AspectFill"
                           WidthRequest="58" HeightRequest="58"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="3">
                    <Label x:Name="BankTrainerNameLabel"
                           FontFamily="NunitoExtraBold" FontSize="22"
                           TextColor="{DynamicResource ThTextPrimary}" MaxLines="1"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="BankSaveGameLabel"
                           FontFamily="Nunito" FontSize="12"
                           TextColor="{DynamicResource ThTextSecondary}" MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <!-- 最右上角：跳回箱子页 -->
                <Border Grid.Column="3" x:Name="ToBoxBtn" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{DynamicResource ThNavBtnBg}"
                        Stroke="{DynamicResource ThNavBtnStroke}" StrokeThickness="1"
                        Padding="12,10" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToBoxTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static svc:UiText.BoxArrow}" FontFamily="NunitoBold" FontSize="12"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- 旧的初训家 ID / 箱子数（控件保留，隐藏） -->
                <Label x:Name="BankSaveMetaLabel" IsVisible="False" Text="" />
            </Grid>

            <!-- ── 银行箱子导航 ── -->
            <Grid x:Name="NavRow" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Padding="16,12,16,8">
                <Border x:Name="PrevBankBtn" Grid.Column="0" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource ThCardBg}"
                        Stroke="{DynamicResource ThNavBtnStroke}" StrokeThickness="1"
                        WidthRequest="40" HeightRequest="36">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrevBoxTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static theme:Ph.CaretLeft}" FontFamily="Phosphor"
                           FontSize="18" TextColor="{DynamicResource ThTextSecondary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="1">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBoxHeaderTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="BankNameLabel"
                           FontFamily="QuicksandExtraBold" FontSize="18"
                           TextColor="{DynamicResource ThTextPrimary}"
                           HorizontalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                    <Label Text="{x:Static svc:UiText.BankHintSubtitle}"
                           FontFamily="Nunito" FontSize="9"
                           TextColor="{DynamicResource ThTextHint}"
                           HorizontalOptions="Center" VerticalOptions="Center" MaxLines="1" />
                </VerticalStackLayout>
                <Border x:Name="NextBankBtn" Grid.Column="2" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{DynamicResource ThCardBg}"
                        Stroke="{DynamicResource ThNavBtnStroke}" StrokeThickness="1"
                        WidthRequest="40" HeightRequest="36">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextBoxTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static theme:Ph.CaretRight}" FontFamily="Phosphor"
                           FontSize="18" TextColor="{DynamicResource ThTextSecondary}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- ── Mode banner：不占行，叠在顶部占位里（与全应用提示条同一套卡片样式） ── -->
            <Border Grid.Row="3" x:Name="ModeBanner"
                    StrokeShape="RoundRectangle 10" StrokeThickness="1"
                    BackgroundColor="{DynamicResource ThHintBg}"
                    Stroke="{DynamicResource ThHintStroke}"
                    Padding="10,4" Margin="12,0,12,6"
                    HorizontalOptions="Fill" VerticalOptions="Center" IsVisible="False">
                <Label x:Name="ModeLabel"
                       FontFamily="NunitoBold" FontSize="12"
                       TextColor="#34D990"
                       HorizontalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation" />
            </Border>

            <!-- ── 顶部占位：与箱子页的搜索行同款同尺寸（44 高 + 12/0/12/6 外边距），
                 银行页没有搜索框，用等高透明占位对齐画布顶边。
                 额外 +2dp 上边距：箱子页 RootGrid 带 RowSpacing="2"，竖屏会把内容整体下推 2dp，
                 银行页没有行间距，这里补回来，两页画布顶边才能严格重合。 ── -->
            <Border Grid.Row="3" x:Name="BoxTopSpacer"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0"
                    BackgroundColor="Transparent" InputTransparent="True"
                    Margin="12,0,12,6" HeightRequest="44" />

            <!-- ── Bank grid ── -->
            <skia:SKCanvasView Grid.Row="4" x:Name="BankCanvas"
                               PaintSurface="OnBankPaintSurface">
                <skia:SKCanvasView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBankTapped" />
                </skia:SKCanvasView.GestureRecognizers>
            </skia:SKCanvasView>

            <!-- ── Info bar（与箱子页同款：两行 Grid、同边距、同字号） ── -->
            <Grid Grid.Row="5" x:Name="BankInfoBar" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="6"
                  BackgroundColor="Transparent" Padding="16,8,16,12">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label x:Name="HoverLabel"
                           FontFamily="Nunito" FontSize="12"
                           TextColor="{DynamicResource ThTextSecondary}"
                           MaxLines="1" LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="HintBar" Spacing="8" VerticalOptions="Center" />
                </ScrollView>
            </Grid>

            <!-- 横屏单栏底栏：左存档/训练家（可点切换）、中间功能徽章、右侧「箱子 ▸」导航 -->
            <Grid x:Name="LsBottomBar" Grid.Row="5" IsVisible="False"
                  ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                  Padding="12,4,12,8"
                  BackgroundColor="{DynamicResource ThTopScreenBg}">
                <HorizontalStackLayout x:Name="LsSaveChip" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSaveChipTapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image x:Name="LsGameIcon" WidthRequest="26" HeightRequest="26" Aspect="AspectFill" />
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label x:Name="LsTrainerName" FontFamily="NunitoExtraBold" FontSize="14"
                               TextColor="{DynamicResource ThTextPrimary}"
                               MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label x:Name="LsGameLabel" FontFamily="Nunito" FontSize="10"
                               TextColor="{DynamicResource ThTextSecondary}"
                               MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Label Text="▾" FontSize="12" TextColor="{DynamicResource ThTextHint}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- 徽章居中：窄屏放不下时横向滚动，不挤掉左右两端 -->
                <ScrollView Grid.Column="1" Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Center">
                    <HorizontalStackLayout x:Name="LsHints" Spacing="6"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                </ScrollView>

                <!-- 横屏银行页去掉了顶部「箱子 ▸」入口，统一在底栏右侧给 -->
                <Border x:Name="LsToBoxBtn" Grid.Column="2"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{DynamicResource ThNavBtnBg}"
                        Stroke="{DynamicResource ThNavBtnStroke}" StrokeThickness="1"
                        Padding="12,8" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToBoxTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static svc:UiText.BoxArrow}" FontFamily="NunitoBold" FontSize="12"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  详情浮层：与箱子页 PhoneDetailSheet 同款布局         -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid x:Name="DetailOverlay" IsVisible="False" BackgroundColor="Transparent"
              InputTransparent="True">
            <BoxView x:Name="DetailScrim" BackgroundColor="#000000" Opacity="0"
                     InputTransparent="True">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDetailScrimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="DetailPanel"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Opacity="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource ThActionMenuPanel}"
                    Stroke="{DynamicResource ThActionMenuStroke}"
                    StrokeThickness="1"
                    Padding="16,14,16,14">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">

                    <!-- Header: sprite + badges/name/level + 右侧竖排三键（与银行页现状一致，无放生） -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <skia:SKCanvasView x:Name="DetailSpriteCanvas"
                                           WidthRequest="90" HeightRequest="90"
                                           PaintSurface="OnDetailSpritePaint"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                            <HorizontalStackLayout x:Name="DetailTypeBadges" Spacing="5"/>
                            <Label x:Name="DetailSpecies"
                                   FontFamily="NunitoExtraBold" FontSize="20"
                                   TextColor="{DynamicResource ThTextPrimary}"
                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                            <Label x:Name="DetailLevelNature"
                                   FontFamily="Nunito" FontSize="12"
                                   TextColor="{DynamicResource ThTextSecondary}"
                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4"
                                             VerticalOptions="Start" HorizontalOptions="End">
                            <Border x:Name="DetailCryBtn" StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{DynamicResource ThHintBg}"
                                    Stroke="{DynamicResource ThHintStroke}" StrokeThickness="1"
                                    Padding="6,3">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDetailCryTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="R 叫声" FontFamily="NunitoBold" FontSize="9"
                                       TextColor="#60C0FF"/>
                            </Border>
                            <Border x:Name="DetailGrabBtn" StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{DynamicResource ThHintBg}"
                                    Stroke="{DynamicResource ThHintStroke}" StrokeThickness="1"
                                    Padding="6,3">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDetailGrabTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="Y 抓取" FontFamily="NunitoBold" FontSize="9"
                                       TextColor="#6BABFF"/>
                            </Border>
                            <Border x:Name="DetailWithdrawBtn" StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#1E2A12"
                                    Stroke="#5FA34A" StrokeThickness="1"
                                    Padding="6,3">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDetailWithdrawTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="取出银行" FontFamily="NunitoBold" FontSize="9"
                                       TextColor="#9BE07A"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 内容区：与箱子页同款三块（招式 / 能力 / 详情），单列串联可滚动；无底部通栏 -->
                    <ScrollView x:Name="DetailSheetScroll" Grid.Row="1"
                                VerticalScrollBarVisibility="Never">
                        <Grid x:Name="DetailSheetContent" RowSpacing="10" Padding="0,2,0,2"
                              RowDefinitions="Auto,Auto,Auto">

                            <!-- 区块 1：招式（2×2） -->
                            <VerticalStackLayout x:Name="DetailSheetMovesView" Grid.Row="0" Spacing="6">
                                <Label Text="招式" FontFamily="NunitoBold" FontSize="9"
                                       TextColor="{DynamicResource ThTextDim}" CharacterSpacing="1.2"/>
                                <Grid x:Name="DetailSheetMovesGrid"
                                      ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="6">
                                    <Border x:Name="DetailMoveRow0" Grid.Row="0" Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="10,*,Auto">
                                            <Ellipse x:Name="DetailMoveDot0" Grid.Column="0" Fill="#A8A878"
                                                     WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                                            <Label x:Name="DetailMoveName0" Grid.Column="1" Margin="6,0,0,0"
                                                   FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label x:Name="DetailMovePP0" Grid.Column="2"
                                                   FontFamily="Nunito" FontSize="10"
                                                   TextColor="{DynamicResource ThTextSecondary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DetailMoveRow1" Grid.Row="0" Grid.Column="1"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="10,*,Auto">
                                            <Ellipse x:Name="DetailMoveDot1" Grid.Column="0" Fill="#A8A878"
                                                     WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                                            <Label x:Name="DetailMoveName1" Grid.Column="1" Margin="6,0,0,0"
                                                   FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label x:Name="DetailMovePP1" Grid.Column="2"
                                                   FontFamily="Nunito" FontSize="10"
                                                   TextColor="{DynamicResource ThTextSecondary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DetailMoveRow2" Grid.Row="1" Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="10,*,Auto">
                                            <Ellipse x:Name="DetailMoveDot2" Grid.Column="0" Fill="#A8A878"
                                                     WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                                            <Label x:Name="DetailMoveName2" Grid.Column="1" Margin="6,0,0,0"
                                                   FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label x:Name="DetailMovePP2" Grid.Column="2"
                                                   FontFamily="Nunito" FontSize="10"
                                                   TextColor="{DynamicResource ThTextSecondary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DetailMoveRow3" Grid.Row="1" Grid.Column="1"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="10,*,Auto">
                                            <Ellipse x:Name="DetailMoveDot3" Grid.Column="0" Fill="#A8A878"
                                                     WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                                            <Label x:Name="DetailMoveName3" Grid.Column="1" Margin="6,0,0,0"
                                                   FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label x:Name="DetailMovePP3" Grid.Column="2"
                                                   FontFamily="Nunito" FontSize="10"
                                                   TextColor="{DynamicResource ThTextSecondary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- 区块 2：能力（2×3，与箱子页同口径） -->
                            <VerticalStackLayout x:Name="DetailSheetStatsView" Grid.Row="1" Spacing="6">
                                <Label Text="能力" FontFamily="NunitoBold" FontSize="9"
                                       TextColor="{DynamicResource ThTextDim}" CharacterSpacing="1.2"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="6">
                                    <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="HP" FontFamily="NunitoBold" FontSize="11"
                                                   TextColor="{DynamicResource ThTextSecondary}" VerticalOptions="Center"/>
                                            <Label x:Name="DetailStatHP" Grid.Column="1" FontFamily="NunitoExtraBold"
                                                   FontSize="13" TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="攻击" FontFamily="NunitoBold" FontSize="11"
                                                   TextColor="{DynamicResource ThTextSecondary}" VerticalOptions="Center"/>
                                            <Label x:Name="DetailStatATK" Grid.Column="1" FontFamily="NunitoExtraBold"
                                                   FontSize="13" TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="防御" FontFamily="NunitoBold" FontSize="11"
                                                   TextColor="{DynamicResource ThTextSecondary}" VerticalOptions="Center"/>
                                            <Label x:Name="DetailStatDEF" Grid.Column="1" FontFamily="NunitoExtraBold"
                                                   FontSize="13" TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="特攻" FontFamily="NunitoBold" FontSize="11"
                                                   TextColor="{DynamicResource ThTextSecondary}" VerticalOptions="Center"/>
                                            <Label x:Name="DetailStatSPA" Grid.Column="1" FontFamily="NunitoExtraBold"
                                                   FontSize="13" TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="特防" FontFamily="NunitoBold" FontSize="11"
                                                   TextColor="{DynamicResource ThTextSecondary}" VerticalOptions="Center"/>
                                            <Label x:Name="DetailStatSPD" Grid.Column="1" FontFamily="NunitoExtraBold"
                                                   FontSize="13" TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Grid.Column="1" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="速度" FontFamily="NunitoBold" FontSize="11"
                                                   TextColor="{DynamicResource ThTextSecondary}" VerticalOptions="Center"/>
                                            <Label x:Name="DetailStatSPE" Grid.Column="1" FontFamily="NunitoExtraBold"
                                                   FontSize="13" TextColor="{DynamicResource ThTextPrimary}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- 区块 3：详情（特性 / 道具 / 性别 / 球种） -->
                            <VerticalStackLayout x:Name="DetailSheetInfoView" Grid.Row="2" Spacing="6">
                                <Label Text="详情" FontFamily="NunitoBold" FontSize="9"
                                       TextColor="{DynamicResource ThTextDim}" CharacterSpacing="1.2"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                      RowSpacing="6" ColumnSpacing="8">
                                    <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="特性" FontFamily="NunitoBold" FontSize="9"
                                                   TextColor="{DynamicResource ThTextSecondary}"/>
                                            <Label x:Name="DetailInfoAbility" FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="道具" FontFamily="NunitoBold" FontSize="9"
                                                   TextColor="{DynamicResource ThTextSecondary}"/>
                                            <Label x:Name="DetailInfoItem" FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="性别" FontFamily="NunitoBold" FontSize="9"
                                                   TextColor="{DynamicResource ThTextSecondary}"/>
                                            <Label x:Name="DetailInfoGender" FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{DynamicResource ThMoveRowBg}"
                                            Stroke="{DynamicResource ThMoveRowStroke}" StrokeThickness="1"
                                            Padding="8,7">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="球种" FontFamily="NunitoBold" FontSize="9"
                                                   TextColor="{DynamicResource ThTextSecondary}"/>
                                            <Label x:Name="DetailInfoBall" FontFamily="NunitoBold" FontSize="12"
                                                   TextColor="{DynamicResource ThTextPrimary}"
                                                   MaxLines="1" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                        </Grid>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
